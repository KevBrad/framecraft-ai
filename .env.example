# Set these in your shell before starting. No paid provider or API key required.
WHISPER_MODEL=tiny.en
# WHISPER_MODEL=base  # multilingual; first use downloads separate model weights
# WHISPER_MODEL_PATH=C:/models/converted-whisper
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
MAX_UPLOAD_MB=1024
MAX_DISK_GB=20
MAX_WORKER_MB=2048
MAX_MEDIA_DURATION=7200
JOB_TIMEOUT_SECONDS=3600
# Audio is read in bounded cores plus 2 seconds of context on either side.
TRANSCRIBE_CHUNK_SECONDS=30
TRANSCRIBE_TIMEOUT=3600
# FRAMECRAFT_DATA=C:/my-private-workspace

# Google Drive: default is data/connections/google-oauth-client.json
# GOOGLE_OAUTH_CLIENT_FILE=C:/path/to/your/Google-issued-desktop-client.json
# FRAMECRAFT_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/connections/google-drive/callback
# Non-Windows encrypted imports additionally need cryptography + FRAMECRAFT_SECRET_KEY.
